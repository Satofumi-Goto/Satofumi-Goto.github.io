        "action": "manual Render exact-SHA release after independent source and credential gates; verify live Fleet"
      },
      {
        "order": 3,
        "app": "service",
        "action": "Render native auto-deploy on reviewed main; verify build, health and SHA"
      },
      {
        "order": 4,
        "app": "urban",
        "action": "Render native auto-deploy on reviewed main; verify build, health and SHA"
      },
      {
        "order": 5,
        "app": "simulator",
        "action": "Render native auto-deploy on reviewed main; verify build, health and SHA"
      },
      {

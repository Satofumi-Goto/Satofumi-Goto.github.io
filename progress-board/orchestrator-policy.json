{
  "schema_version": 1,
  "name": "development-orchestrator",
  "enabled": true,
  "cadence": "hourly",
  "repositories": [
    "Satofumi-Goto/life-transaction-console",
    "Satofumi-Goto/fleet-operations-console",
    "Satofumi-Goto/service-hub-console",
    "Satofumi-Goto/urban-operation-console",
    "Satofumi-Goto/mobility-business-lab",
    "Satofumi-Goto/seneschal",
    "Satofumi-Goto/federation-portal"
  ],
  "status_source": "progress-board/status.json",
  "priority": [
    "red",
    "yellow",
    "green"
  ],
  "state_rules": {
    "green": "verified active execution with recent evidence",
    "orange": "verified support/remediation execution",
    "yellow": "waiting for a known prerequisite or safe approval",
    "red": "blocked by a concrete failure or unavailable required infrastructure",
    "done": "required merge/validation/deployment evidence is complete"
  },
  "cycle": {
    "max_primary_change_per_repo": 1,
    "max_queue_items": 10,
    "require_progress_action": true,
    "progress_actions": [
      "fix",
      "update_pr",
      "create_pr",
      "merge",
      "static_validation",
      "deployment_validation"
    ]
  },
  "ci": {
    "detect_infrastructure_blocked": {
      "all_required": [
        "steps_empty",
        "runner_id_zero",
        "runner_name_empty",
        "fast_failure_seconds_lte_5"
      ]
    },
    "on_infrastructure_blocked": {
      "rerun": false,
      "code_failure": false,
      "continue_low_risk_changes": true,
      "executable_code_merge": false,
      "executable_code_pr_allowed": true,
      "static_validation_allowed": true
    },
    "on_code_failure": {
      "inspect_failure_evidence": true,
      "fix_on_dedicated_branch": true,
      "retry_after_fix": true,
      "narrow_after_same_failure_count": 2
    },
    "rendering_rules": {
      "infrastructure_blocked_label": "CI infrastructure blocked",
      "never_call_named_job_code_failure_when_steps_empty": true,
      "never_attribute_failure_to_check_name_without_executed_steps": true,
      "require_executed_step_or_annotation_before_code_failure": true,
      "refresh_main_head_before_each_render": true,
      "quota_blocked_label": "CI usage quota blocked"
    },
    "quota_recovery": {
      "state": "quota_blocked",
      "periodic_rerun": false,
      "recovery_evidence": [
        "a newly triggered non-dynamic required workflow obtains runner_id > 0 and at least one executed step",
        "GitHub account usage/billing evidence shows the Actions quota is available again",
        "billing period rollover at or after 2026-11-01T00:00:00Z permits one Activity release probe"
      ],
      "probe_policy": {
        "automatic_probe_only_after_external_recovery_evidence_or_billing_rollover": true,
        "max_probe_workflows": 1,
        "preferred_probe": "Activity Base44 release marker",
        "success_requires": [
          "runner_id_nonzero",
          "runner_name_nonempty",
          "executed_steps_nonempty"
        ],
        "on_success": "continue the seven-app release sequence one app at a time",
        "on_failure_before_steps": "return to quota_blocked without additional reruns",
        "release_probe_order": [
          "activity",
          "fleet",
          "service",
          "urban",
          "simulator",
          "seneschal",
          "federation"
        ],
        "activity_is_single_initial_probe": true
      }
    }
  },
  "auto_merge": {
    "allowed_when": [
      "non_draft",
      "mergeable",
      "required_ci_success",
      "scope_is_expected",
      "no_secret_or_token_change",
      "no_billing_or_budget_change",
      "no_auth_grant_change",
      "no_irreversible_external_action"
    ],
    "denied_when": [
      "ci_infrastructure_blocked_for_executable_code",
      "draft",
      "conflict",
      "required_ci_unknown",
      "secret_or_token_change",
      "billing_or_budget_change",
      "auth_grant_change",
      "data_deletion",
      "external_transaction_or_booking_or_message"
    ]
  },
  "deployment": {
    "base44_publish_only_if": [
      "safe_publish_path_available",
      "github_main_sha_match_confirmed"
    ],
    "completion_requires": [
      "publish_if_required",
      "public_version_validation_if_required"
    ],
    "github_two_way_sync_is_not_publish": true,
    "render_source_merge_as": "source integrated",
    "render_completion_only_after": [
      "main_publish",
      "deployed_sha_match",
      "authenticated_e2e_if_applicable"
    ],
    "release_pipelines": {
      "activity": {
        "repo": "Satofumi-Goto/life-transaction-console",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Federation operational proxy",
        "public_url": "https://life-ledger-link.base44.app",
        "release_order": 1,
        "verifies": [
          "exact_published_sha",
          "authenticated_console_health",
          "durable_release_event_ack"
        ]
      },
      "fleet": {
        "repo": "Satofumi-Goto/fleet-operations-console",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Federation operational proxy",
        "public_url": "https://fleet-operations-console.base44.app",
        "release_order": 2,
        "only_after": "activity_release_verified",
        "verifies": [
          "exact_published_sha",
          "authenticated_console_health",
          "durable_release_event_ack"
        ]
      },
      "service": {
        "repo": "Satofumi-Goto/service-hub-console",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Federation operational proxy",
        "public_url": "https://service-hub-console.base44.app",
        "release_order": 3,
        "only_after": "fleet_release_verified",
        "verifies": [
          "exact_published_sha",
          "authenticated_console_health",
          "durable_release_event_ack"
        ]
      },
      "urban": {
        "repo": "Satofumi-Goto/urban-operation-console",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Federation operational proxy",
        "public_url": "https://urban-operation-console.base44.app",
        "release_order": 4,
        "only_after": "service_release_verified",
        "verifies": [
          "exact_published_sha",
          "authenticated_console_health",
          "durable_release_event_ack"
        ]
      },
      "simulator": {
        "repo": "Satofumi-Goto/mobility-business-lab",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Fed actual-operation",
        "public_url": "https://mobility-lab-flow.base44.app",
        "release_order": 5,
        "only_after": "urban_release_verified",
        "verifies": [
          "exact_published_sha",
          "real_compute_two_calls",
          "kpi_hash_receipt",
          "priority_read",
          "simulator_to_federation_info_health"
        ]
      },
      "seneschal": {
        "repo": "Satofumi-Goto/seneschal",
        "trigger_file": ".base44-sync-trigger",
        "workflow": "Base44 release — Fed actual-operation",
        "public_url": "https://seneschal.base44.app",
        "release_order": 6,
        "only_after": "simulator_release_verified",
        "verifies": [
          "exact_published_sha",
          "seneschal_to_federation_health",
          "durable_source_change_ack",
          "production_voice_ui"
        ]
      },
      "federation": {
        "repo": "Satofumi-Goto/federation-portal",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Federation release reality check",
        "public_url": "https://federation.base44.app",
        "release_order": 7,
        "only_after": "release_state_for_first_six_committed",
        "verifies": [
          "federation_site_publish",
          "served_sha_or_ancestry",
          "all_federation_backends_deployed"
        ]
      }
    },
    "base44_key_gate": {
      "secret_name": "BASE44_API_KEY",
      "secret_value_must_never_be_read_or_exposed": true,
      "readiness_source": "release workflow fail-closed credential step",
      "on_missing_or_invalid": "stop_release_retries_and_notify_one_time_setup_required",
      "on_ready": "continue_deploy_and_public_sha_validation"
    },
    "release_state": {
      "file": "docs/runbooks/fed-actual-operation-release-state.json",
      "schema": "federation.base44-release-set/1",
      "create_only_after": [
        "activity_release_verified",
        "fleet_release_verified",
        "service_release_verified",
        "urban_release_verified",
        "simulator_release_verified",
        "seneschal_release_verified"
      ],
      "expected_keys": [
        "activity",
        "fleet",
        "service",
        "urban",
        "simulator",
        "seneschal"
      ],
      "sha_source": "successful_release_workflow_head_sha",
      "must_be_committed_before_federation_release_marker": true,
      "prepared": true,
      "frozen_first_six": {
        "activity": "3991dd2f6b51aef5aee9428fbba650aa15529af2",
        "fleet": "d555d286aaeae84c4218869ed0bb0ad23c9c043d",
        "service": "f2692add810011da46f686d24bc98ba7f8713e1c",
        "urban": "983c852acbd9ec1d24ccebf87c36230d5b0b86bd",
        "simulator": "23c226d97f7ab42468a3de4ce70f1da72f58c774",
        "seneschal": "e080d3841837f4a0ac8e877d8db01192c130e709"
      }
    },
    "final_e2e": {
      "repo": "Satofumi-Goto/federation-portal",
      "workflow": "Fed seven-app production E2E",
      "trigger": "successful Federation release workflow_run",
      "federation_sha_source": "Federation release workflow_run head_sha",
      "first_six_sha_source": "docs/runbooks/fed-actual-operation-release-state.json",
      "completion_requires": [
        "seven_public_sha_exact_match",
        "federation_to_simulator_real_compute_two_calls",
        "simulator_priority_read",
        "four_console_app_api_roundtrips",
        "same_sha_full_live_mission_browser_contract"
      ],
      "only_final_workflow_success_marks_fed_actual_operation_complete": true
    },
    "federation_frozen_head": "39797b8bcc15650ccfd7433d259df97162353a69",
    "publication_sequence": [
      {
        "order": 1,
        "app": "activity",
        "action": "Run Base44 release — Federation operational proxy on main"
      },
      {
        "order": 2,
        "app": "fleet",
        "action": "Run Base44 release — Federation operational proxy on main"
      },
      {
        "order": 3,
        "app": "service",
        "action": "Run Base44 release — Federation operational proxy on main"
      },
      {
        "order": 4,
        "app": "urban",
        "action": "Run Base44 release — Federation operational proxy on main"
      },
      {
        "order": 5,
        "app": "simulator",
        "action": "Run Base44 release — Fed actual-operation on main"
      },
      {
        "order": 6,
        "app": "seneschal",
        "action": "Run Base44 release — Fed actual-operation on main"
      },
      {
        "order": 7,
        "app": "federation",
        "action": "Run Federation release reality check on main with deploy_fed_actual_operation=true"
      },
      {
        "order": 8,
        "app": "final",
        "action": "Fed seven-app production E2E runs automatically after successful Federation release"
      }
    ],
    "no_marker_commit_required_for_publication": true
  },
  "viewer_boundary": {
    "general_user_status_display": "read_only",
    "diagnostic_allowance_consumption": false,
    "notification_subscription": false,
    "canonical_write": false
  },
  "notification": {
    "quiet_on_normal_progress": true,
    "notify_on": [
      "new_major_red",
      "approval_required_for_sensitive_action",
      "repeated_same_blocker",
      "status_update_failure"
    ]
  },
  "status_rendering": {
    "required_sections": [
      "apps",
      "rows",
      "orchestrator",
      "action_queue",
      "fed_actual_operation"
    ],
    "fed_actual_operation": {
      "preserve_across_sweeps": true,
      "refresh_main_heads_each_sweep": true,
      "never_mark_complete_from_source_merge_alone": true,
      "completion_requires": [
        "main_publish",
        "deployed_sha_match",
        "authenticated_e2e_if_applicable"
      ],
      "zero_step_ci_is_infrastructure_blocker_not_code_failure": true
    }
  },
  "mode": "release-freeze",
  "release_freeze": {
    "enabled": true,
    "reason": "Fed actual-operation source and release automation are complete; publication only remains.",
    "frozen_at": "2026-10-25",
    "frozen_heads": {
      "activity": "3991dd2f6b51aef5aee9428fbba650aa15529af2",
      "fleet": "d555d286aaeae84c4218869ed0bb0ad23c9c043d",
      "service": "f2692add810011da46f686d24bc98ba7f8713e1c",
      "urban": "983c852acbd9ec1d24ccebf87c36230d5b0b86bd",
      "simulator": "23c226d97f7ab42468a3de4ce70f1da72f58c774",
      "seneschal": "e080d3841837f4a0ac8e877d8db01192c130e709",
      "federation": "39797b8bcc15650ccfd7433d259df97162353a69"
    },
    "source_changes_allowed": false,
    "exceptions": [
      "a publication attempt produces concrete executable failure evidence that cannot be resolved by rerun or configuration",
      "security-critical defect discovered in the frozen release candidate"
    ],
    "old_open_prs_are_deferred_backlog_not_release_blockers": true,
    "preferred_release_trigger": "manual workflow_dispatch on main; do not create new marker commits",
    "publication_only": true
  }
}

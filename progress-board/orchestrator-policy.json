      "enforceable PR branch protection",
      "exact SHA native publish verification where auto-deploy OFF"
    ],
    "re_enable_prohibited": false,
    "exception_scope": "Satofumi-Goto/federation-portal existing source-only QA workflows only; other repositories require separate owner approval",

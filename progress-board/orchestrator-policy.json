        "fleet": "d555d286aaeae84c4218869ed0bb0ad23c9c043d",
        "service": "f2692add810011da46f686d24bc98ba7f8713e1c",
        "urban": "983c852acbd9ec1d24ccebf87c36230d5b0b86bd",
        "simulator": "23c226d97f7ab42468a3de4ce70f1da72f58c774",
        "seneschal": "841199084403b6edfa9b5927400ef9fd78acd9c7"
      },
      "productionReleaseVerified": false,
      "federation_publish_gate": "first six public git-head.json values must exactly match the frozen set",
      "no_post_publication_commit_required": true
    }
  },
  "viewer_boundary": {
    "general_user_status_display": "read_only",
    "diagnostic_allowance_consumption": false,
    "notification_subscription": false,
    "canonical_write": false
  },
  "notification": {
    "quiet_on_normal_progress": true,
    "notify_on": [
      "new_major_red",
      "approval_required_for_sensitive_action",
      "repeated_same_blocker",
      "status_update_failure"
    ]
  },
  "status_rendering": {
    "required_sections": [
      "apps",
      "rows",
      "orchestrator",
      "action_queue",
      "fed_actual_operation"
    ],
    "fed_actual_operation": {
      "preserve_across_sweeps": true,
      "refresh_main_heads_each_sweep": true,
      "never_mark_complete_from_source_merge_alone": true,
      "completion_requires": [
        "main_publish",
        "deployed_sha_match",
        "authenticated_e2e_if_applicable"
      ],
      "zero_step_ci_is_infrastructure_blocker_not_code_failure": true
    }
  },
  "mode": "release-freeze",
  "release_freeze": {
    "enabled": false,
    "reason": "Owner explicitly lifted the 2026-10-26 source release freeze on 2026-10-29 JST. Frozen SHA values remain as historical evidence, NOT current release gates. Development and PR validation may continue; real CI success, secrets, permission, current source/version and deployed E2E checks remain mandatory for publication.",
    "frozen_at": "2026-10-26",
    "frozen_heads": {
      "activity": "3991dd2f6b51aef5aee9428fbba650aa15529af2",
      "fleet": "d555d286aaeae84c4218869ed0bb0ad23c9c043d",
      "service": "f2692add810011da46f686d24bc98ba7f8713e1c",
      "urban": "983c852acbd9ec1d24ccebf87c36230d5b0b86bd",
      "simulator": "23c226d97f7ab42468a3de4ce70f1da72f58c774",
      "seneschal": "841199084403b6edfa9b5927400ef9fd78acd9c7",
      "federation": "a5fa3f2a63461ede0d94c5521e86b04f10e76e7d"
    },
    "source_changes_allowed": true,
    "exceptions": [
      "a publication attempt produces concrete executable failure evidence that cannot be resolved by rerun or configuration",
      "security-critical defect discovered in the frozen release candidate"
    ],
    "old_open_prs_are_deferred_backlog_not_release_blockers": true,
    "preferred_release_trigger": "native host build/release for reviewed SHA, never GitHub Actions workflow_dispatch",
    "publication_only": false,
    "unfrozen_at": "2026-10-29",
    "unfrozen_by": "owner_instruction"
  },
  "cooperative_development": {
    "enabled": true,
    "charter_file": "docs/runbooks/cooperative-development-charter.md",
    "ledger_file": "progress-board/cooperative-work-ledger.json",
    "live_claim_source": "https://github.com/Satofumi-Goto/Satofumi-Goto.github.io/issues/74",
    "ledger_is_snapshot_not_live_lock": true,
    "orchestrator": "existing-hourly-development-orchestrator",
    "new_recurring_jobs_allowed": false,
    "coordinator_count": 1,
    "collaborator_role_slots": 6,
    "collaborator_slots_are_not_verified_running_agents": true,
    "single_primary_owner_per_case": true,
    "fixed_phase_silos": false,
    "first_check": [
      "release_freeze",
      "ci.actions_execution",
      "main",
      "existing_issue_pr",
      "ledger_claims",
      "changed_files"
    ],
    "workflow": [
      "investigate",
      "declare_claim",
      "small_patch_branch",
      "local_tests_native_build_browser_qa",
      "independent_review_or_owner_approved_solo",
      "merge_when_required_gates_pass",
      "owner_publish",
      "post_publish_sha_and_browser_e2e",
      "evidence_and_pr_cleanup"
    ],
    "pr_classifications": [
      "needed_no_conflict",
      "needed_conflict_migrate",
      "already_implemented_duplicate_close",
      "obsolete_close"
    ],
    "completion_requires": [
      "source_merged",
      "verified_local_quality_and_native_build",
      "review_gate_satisfied_for_exact_sha",
      "old_pr_triage",
      "owner_production_publish_if_required",
      "real_browser_e2e",
      "evidence",
      "no_regression"
    ],
    "public_release_actor": "user_only",
    "merge_is_not_completion": true,
    "preserve_existing_status_rows": true
  },
  "actions_free_migration": {
    "effective_date": "2026-11-07",
    "private_repositories": 7,
    "settings_state": "federation_portal_actions_enabled_other_repositories_unverified",
    "unresolved": [

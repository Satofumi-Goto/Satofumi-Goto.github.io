{
  "schema_version": 1,
  "name": "development-orchestrator",
  "enabled": true,
  "cadence": "hourly",
  "repositories": [
    "Satofumi-Goto/life-transaction-console",
    "Satofumi-Goto/fleet-operations-console",
    "Satofumi-Goto/service-hub-console",
    "Satofumi-Goto/urban-operation-console",
    "Satofumi-Goto/mobility-business-lab",
    "Satofumi-Goto/seneschal",
    "Satofumi-Goto/federation-portal"
  ],
  "status_source": "progress-board/status.json",
  "priority": [
    "red",
    "yellow",
    "green"
  ],
  "state_rules": {
    "green": "verified active execution with recent evidence",
    "orange": "verified support/remediation execution",
    "yellow": "waiting for a known prerequisite or safe approval",
    "red": "blocked by a concrete failure or unavailable required infrastructure",
    "done": "required merge/validation/deployment evidence is complete"
  },
  "cycle": {
    "max_primary_change_per_repo": 1,
    "max_queue_items": 10,
    "require_progress_action": true,
    "progress_actions": [
      "fix",
      "update_pr",
      "create_pr",
      "merge",
      "static_validation",
      "deployment_validation"
    ]
  },
  "ci": {
    "detect_infrastructure_blocked": {
      "all_required": [
        "steps_empty",
        "runner_id_zero",
        "runner_name_empty",
        "fast_failure_seconds_lte_5"
      ]
    },
    "on_infrastructure_blocked": {
      "rerun": false,
      "code_failure": false,
      "continue_low_risk_changes": true,
      "executable_code_merge": false,
      "executable_code_pr_allowed": true,
      "static_validation_allowed": true
    },
    "on_code_failure": {
      "inspect_failure_evidence": true,
      "fix_on_dedicated_branch": true,
      "retry_after_fix": true,
      "narrow_after_same_failure_count": 2
    },
    "rendering_rules": {
      "infrastructure_blocked_label": "CI infrastructure blocked",
      "never_call_named_job_code_failure_when_steps_empty": true,
      "never_attribute_failure_to_check_name_without_executed_steps": true,
      "require_executed_step_or_annotation_before_code_failure": true,
      "refresh_main_head_before_each_render": true,
      "quota_blocked_label": "CI usage quota blocked"
    },
    "quota_recovery": {
      "state": "owner_reported_actions_reenabled_pending_live_budget_verification",
      "periodic_rerun": false,
      "recovery_evidence": [
        "Owner verified Actions enabled in federation-portal and set account-wide USD 90/month budget with stop-at-limit on 2026-11-08; actual runner and remaining-balance proof is still required before CI is called recovered"
      ],
      "probe_policy": {
        "automatic_probe_only_after_external_recovery_evidence_or_billing_rollover": true,
        "max_probe_workflows": 1,
        "preferred_probe": "one_existing_reviewed_workflow_for_exact_pr_sha",
        "success_requires": [
          "host_native_build_pass",
          "deployed_sha_verified"
        ],
        "on_success": "proceed via reviewed source and native host only",
        "on_failure_before_steps": "HOLD; diagnose quota/runner before any retry",
        "release_probe_order": [],
        "activity_is_single_initial_probe": false
      }
    },
    "actions_execution": {
      "enabled": true,
      "required_mode": "bounded_existing_workflows_plus_local_native_quality_gate",
      "repository_policy": "Owner re-enabled GitHub Actions only in Satofumi-Goto/federation-portal on 2026-11-08; per-repository quota and actual runner must be checked",
      "allowed_repositories": [
        "Satofumi-Goto/federation-portal"
      ],
      "allowed_manual_workflows": [
        "independent-runtime-pr-check.yml",
        "federation-shared-api-ci.yml"
      ],
      "max_manual_dispatch_per_workflow_per_exact_head": 1,
      "monthly_actions_budget_usd": 90,
      "stop_usage_when_budget_reached": true,
      "budget_blocked_is_not_build_success": true,
      "prohibited_actions": [
        "enable_actions_without_owner_authorization",
        "unbounded_workflow_dispatch",
        "blind_rerun_without_failure_diagnosis",
        "create_or_modify_actions_workflow_without_review",
        "bypass_required_review_or_protected_checks",
        "enable_actions_in_other_repositories_without_owner_approval",
        "production_publish_or_paid_ai_execution_via_source_qa"
      ],
      "on_attempt": "Only run an allowlisted source-only QA workflow for Satofumi-Goto/federation-portal after exact HEAD, owner approval, USD 90/month stop setting, available budget, and no duplicate in-progress run are verified; otherwise HOLD; never deploy",
      "local_quality_gate": "federation-portal/scripts/actions-free/portable-gate.mjs",
      "same_sha_review_required": true,
      "git_source_of_truth": "main",
      "portfolio_pages_exception": "Satofumi-Goto.github.io remains enabled only until Pages deployment is replaced and verified"
    }
  },
  "auto_merge": {
    "allowed_when": [
      "non_draft",
      "mergeable",
      "local_quality_evidence_for_exact_sha",
      "scope_is_expected",
      "no_secret_or_token_change",
      "no_billing_or_budget_change",
      "no_auth_grant_change",
      "no_irreversible_external_action",
      "review_gate_satisfied_for_exact_sha"
    ],
    "review_gate": {
      "mode": "independent_review_or_owner_approved_solo",
      "owner_account": "Satofumi-Goto",
      "owner_solo_policy_approved_on": "2026-11-08",
      "owner_solo_is_independent_review": false,
      "independent_review_preferred_when_real_reviewer_is_available": true,
      "solo_allowed_only_when": [
        "sole_verified_repository_maintainer_no_distinct_reviewer_available",
        "explicit_owner_authorization_for_solo_workflow_recorded",
        "owner_review_recorded_on_pr_for_exact_head_sha",
        "full_diff_and_latest_main_scope_checked",
        "native_local_test_and_build_evidence_or_explicit_hold",
        "required_protected_file_sha_label_from_authorized_owner_if_applicable",
        "no_missing_required_quality_or_security_gate"
      ],
      "solo_evidence_fields": [
        "pr_url",
        "head_sha",
        "base_main_sha",
        "changed_paths",
        "risk_and_revert",
        "test_build_and_browser_evidence",
        "owner_approval_evidence",
        "protected_file_label_if_applicable",
        "published_sha_or_not_published"
      ],
      "sensitive_changes_never_silently_auto_approved": [
        "secrets",
        "authentication_authorization_grants",
        "billing_and_budget",
        "irreversible_data_changes",
        "external_transactions_or_messages"
      ],
      "branch_protection_and_existing_protected_checks_remain_enforced": true,
      "owner_solo_review_does_not_authorize_deployment": true
    },
    "denied_when": [
      "ci_infrastructure_blocked_for_executable_code",
      "draft",
      "conflict",
      "local_quality_evidence_unknown",
      "secret_or_token_change",
      "billing_or_budget_change",
      "auth_grant_change",
      "data_deletion",
      "external_transaction_or_booking_or_message",
      "unbounded_or_unreviewed_github_actions_requested"
    ]
  },
  "deployment": {
    "base44_publish_only_if": [
      "safe_publish_path_available",
      "github_main_sha_match_confirmed"
    ],
    "completion_requires": [
      "publish_if_required",
      "public_version_validation_if_required"
    ],
    "github_two_way_sync_is_not_publish": true,
    "render_source_merge_as": "source integrated",
    "render_completion_only_after": [
      "main_publish",
      "deployed_sha_match",
      "authenticated_e2e_if_applicable"
    ],
    "release_pipelines": {
      "activity": {
        "repo": "Satofumi-Goto/life-transaction-console",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Federation operational proxy",
        "public_url": "https://life-ledger-link.base44.app",
        "release_order": 1,
        "verifies": [
          "exact_published_sha",
          "authenticated_console_health",
          "durable_release_event_ack"
        ],
        "preferred_trigger": "native_host_exact_sha_or_owner_verified_manual_publish",
        "legacy_workflow_disabled": true,
        "actions_execution_allowed": false
      },
      "fleet": {
        "repo": "Satofumi-Goto/fleet-operations-console",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Federation operational proxy",
        "public_url": "https://fleet-operations-console.base44.app",
        "release_order": 2,
        "only_after": "activity_release_verified",
        "verifies": [
          "exact_published_sha",
          "authenticated_console_health",
          "durable_release_event_ack"
        ],
        "preferred_trigger": "native_host_exact_sha_or_owner_verified_manual_publish",
        "legacy_workflow_disabled": true,
        "actions_execution_allowed": false
      },
      "service": {
        "repo": "Satofumi-Goto/service-hub-console",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Federation operational proxy",
        "public_url": "https://service-hub-console.base44.app",
        "release_order": 3,
        "only_after": "fleet_release_verified",
        "verifies": [
          "exact_published_sha",
          "authenticated_console_health",
          "durable_release_event_ack"
        ],
        "preferred_trigger": "native_host_exact_sha_or_owner_verified_manual_publish",
        "legacy_workflow_disabled": true,
        "actions_execution_allowed": false
      },
      "urban": {
        "repo": "Satofumi-Goto/urban-operation-console",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Federation operational proxy",
        "public_url": "https://urban-operation-console.base44.app",
        "release_order": 4,
        "only_after": "service_release_verified",
        "verifies": [
          "exact_published_sha",
          "authenticated_console_health",
          "durable_release_event_ack"
        ],
        "preferred_trigger": "native_host_exact_sha_or_owner_verified_manual_publish",
        "legacy_workflow_disabled": true,
        "actions_execution_allowed": false
      },
      "simulator": {
        "repo": "Satofumi-Goto/mobility-business-lab",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Base44 release — Fed actual-operation",
        "public_url": "https://mobility-lab-flow.base44.app",
        "release_order": 5,
        "only_after": "urban_release_verified",
        "verifies": [
          "exact_published_sha",
          "real_compute_two_calls",
          "kpi_hash_receipt",
          "priority_read",
          "simulator_to_federation_info_health"
        ],
        "preferred_trigger": "native_host_exact_sha_or_owner_verified_manual_publish",
        "legacy_workflow_disabled": true,
        "actions_execution_allowed": false
      },
      "seneschal": {
        "repo": "Satofumi-Goto/seneschal",
        "trigger_file": null,
        "workflow": "Base44 release — Fed actual-operation",
        "public_url": "https://seneschal.base44.app",
        "release_order": 6,
        "only_after": "simulator_release_verified",
        "verifies": [
          "exact_published_sha",
          "seneschal_to_federation_health",
          "durable_source_change_ack",
          "production_voice_ui"
        ],
        "preferred_trigger": "native_host_exact_sha_or_owner_verified_manual_publish",
        "legacy_workflow_disabled": true,
        "actions_execution_allowed": false
      },
      "federation": {
        "repo": "Satofumi-Goto/federation-portal",
        "trigger_file": ".base44-release-trigger",
        "workflow": "Federation release reality check",
        "public_url": "https://federation.base44.app",
        "release_order": 7,
        "only_after": "first_six_public_shas_match_frozen_preflight",
        "verifies": [
          "federation_site_publish",
          "served_sha_or_ancestry",
          "all_federation_backends_deployed"
        ],
        "preferred_trigger": "native_host_exact_sha_or_owner_verified_manual_publish",
        "legacy_workflow_disabled": true,
        "actions_execution_allowed": false
      }
    },
    "base44_key_gate": {
      "secret_name": "BASE44_API_KEY",
      "secret_value_must_never_be_read_or_exposed": true,
      "readiness_source": "native hosting secret configuration attestations (never disclose or read value)",
      "on_missing_or_invalid": "stop_release_retries_and_notify_one_time_setup_required",
      "on_ready": "continue host-native reviewed exact-SHA publication and public version validation"
    },
    "final_e2e": {
      "repo": "Satofumi-Goto/federation-portal",
      "workflow": "Fed seven-app production E2E",
      "trigger": "successful Federation release workflow_run",
      "federation_sha_source": "Federation release workflow_run head_sha",
      "first_six_sha_source": "docs/runbooks/fed-actual-operation-preflight-source-heads.json",
      "completion_requires": [
        "seven_public_sha_exact_match",
        "federation_to_simulator_real_compute_two_calls",
        "simulator_priority_read",
        "four_console_app_api_roundtrips",
        "same_sha_full_live_mission_browser_contract"
      ],
      "only_final_workflow_success_marks_fed_actual_operation_complete": true
    },
    "federation_frozen_head": "a5fa3f2a63461ede0d94c5521e86b04f10e76e7d",
    "publication_sequence": [
      {
        "order": 1,
        "app": "activity",
        "action": "manual Render exact-SHA release after independent source and credential gates; verify live Activity"
      },
      {
